{
	"name": "checklist-alug",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"test:unit": "vitest run",
		"test:rules": "node scripts/run-shared-rules-tests.js",
		"test": "npm run test:unit && npm run check && npm run build",
		"verify": "npm test && npm run test:rules && npm audit --omit=dev",
		"ops:record-baseline": "node --env-file-if-exists=.env scripts/record-rollout-baseline.js",
		"ops:reset": "node --env-file-if-exists=.env scripts/reset-checklist-data.js",
		"ops:expand-claims": "node --env-file-if-exists=.env scripts/expand-operations-claims.js",
		"ops:rollback-claims": "node --env-file-if-exists=.env scripts/rollback-operations-claims.js",
		"test:ui": "node scripts/verify-ui.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.9.1",
		"fake-indexeddb": "^6.2.5",
		"puppeteer-core": "^25.0.4",
		"svelte": "^5.55.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.2.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"firebase": "^12.13.0",
		"firebase-admin": "^14.0.0"
	},
	"overrides": {
		"@google-cloud/storage": "8.0.1",
		"brace-expansion": "2.1.4",
		"form-data": "2.5.6",
		"gaxios": "7.3.1",
		"jwks-rsa": {
			"jose": "4.15.9"
		},
		"protobufjs": "7.6.5",
		"retry-request": "9.0.1",
		"teeny-request": "11.0.1",
		"uuid": "11.1.1",
		"websocket-driver": "0.7.5"
	}
}
